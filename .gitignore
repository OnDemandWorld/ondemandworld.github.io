# This repo is the GitHub Pages output for the ODW.ai org site.
# Track only the final site files; ignore everything else by default.

# Ignore everything by default
*

# Allow final site files
!index.html
!styles.css
!styles-v1.css
!app.js
!app-v1.js
!.gitignore
!.github/

# Favicons and site icons
!favicon.svg
!favicon.png
!favicon-16x16.png
!favicon-32x32.png
!apple-touch-icon.png
!android-chrome-192x192.png
!android-chrome-512x512.png
!site.webmanifest

# Logo files
!odwai-logo-*.png

# FAQ directory
!faq/
!faq/index.html
!faq/styles.css
!faq/*.html

# Localization directories
!zh-cn/
!zh-cn/index.html
!zh-cn/faq/
!zh-cn/faq/*.html
!zh-cn/faq/*.css
!zh-hk/
!zh-hk/index.html
!zh-hk/faq/
!zh-hk/faq/*.html
!zh-hk/faq/*.css

# Company pages ported from ondemandworld.com (URLs preserved)
!company.css
!company.js
!404.html
!sitemap.xml
!robots.txt
!privacy-policy/
!privacy-policy/index.html
!terms-and-conditions/
!terms-and-conditions/index.html
!house-rules/
!house-rules/index.html
!about-us/
!about-us/index.html
!contact-us/
!contact-us/index.html
!our-products/
!our-products/index.html
!2024/
!2024/01/
!2024/01/*/
!2024/01/*/index.html
!assets/
!assets/products/
!assets/products/*.jpg

# Legacy app "about" pages — checked in as-is (whole subtree).
# Placed before the exclusions below so .DS_Store inside stays ignored.
!about/
!about/**

# Explicitly exclude internal docs (even if in allowed directories)
*.md
*.txt
*.log
.DS_Store
v2-wip/

# ...but robots.txt / ads.txt are site files, not docs (must come after *.txt)
!robots.txt
!ads.txt

# Tracked documentation (must come after *.md)
!README.md
!CHANGELOG.md
!CLAUDE.md
